# Copy to deploy/.env. Never commit secrets. This is not ready to deploy unchanged.
SITE_DOMAIN=your-domain.example
PUBLIC_WEB_URL=https://your-domain.example
APP_ENV=production
COOKIE_SECURE=true
ALLOWED_ORIGINS=["https://your-domain.example"]
POSTGRES_PASSWORD=replace-with-random-password
DATABASE_URL=postgresql+asyncpg://promt:replace-with-random-password@db:5432/promt_market
CSRF_SECRET=replace-with-at-least-32-random-characters
MAIL_ENCRYPTION_KEY=replace-with-fernet-key
MAIL_DELIVERY=smtp
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=promtmarket@mail.ru
SMTP_FROM=promtmarket@mail.ru
SMTP_PASSWORD=replace-with-application-password
LOCAL_TEST_ACCESS_ENABLED=false
SBER_SANDBOX_ENABLED=false
SBER_WEBHOOK_ENABLED=false
# Must stay false until finalized documents, operator details and processing procedures exist.
LEGAL_READY=false

AUTH_PROXY_SECRET=replace-with-at-least-32-random-characters
