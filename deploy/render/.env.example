# Import private values into Render's Environment settings, never commit actual secrets.
# Render supplies PORT and RENDER_EXTERNAL_URL. The supervisor derives the public origin
# and both CSRF origin allowlists automatically, unless you explicitly set them.
APP_ENV=production
# Catalog-only launch: no database, API, accounts, orders, payments or mail worker.
# Set false only when the full store's production checks and setup are complete.
PUBLIC_PREVIEW=true
# Set true together with PUBLIC_PREVIEW=false after account privacy information is ready.
# Accounts-only mode keeps production order creation and Platega disabled while LEGAL_READY=false.
REGISTRATION_READY=false
COOKIE_SECURE=true
DATABASE_URL=postgresql://neondb_owner:replace-password@replace-host/neondb?sslmode=require
CSRF_SECRET=replace-with-at-least-32-random-characters
AUTH_PROXY_SECRET=replace-with-at-least-32-random-characters
MAIL_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# Render Free blocks SMTP ports. Deploy the provided script in your Gmail account.
# Copy the same secret into Apps Script's GOOGLE_MAIL_SECRET script property.
MAIL_DELIVERY=google_apps_script
GOOGLE_MAIL_URL=
GOOGLE_MAIL_SECRET=replace-with-at-least-32-random-characters

# Keep false until the legal documents, operator details and procedures are finalized.
# Full-store backend startup deliberately refuses operation while this is false.
LEGAL_READY=false
LOCAL_TEST_ACCESS_ENABLED=false
SBER_SANDBOX_ENABLED=false
SBER_WEBHOOK_ENABLED=false
PLATEGA_ENABLED=false
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
