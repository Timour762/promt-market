APP_NAME=??????????? API
DATABASE_URL=postgresql+asyncpg://promt:local_only@localhost:5438/promt_market

# Generate a random value of at least 32 characters locally. Never commit the real secret.
CSRF_SECRET=replace_with_a_random_local_secret_at_least_32_chars
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:3107","http://127.0.0.1:3107"]

# Generate with Fernet.generate_key(), store only in your private .env.
MAIL_ENCRYPTION_KEY=replace_with_a_generated_fernet_key
PUBLIC_WEB_URL=http://localhost:3107
MAIL_DELIVERY=local

LOCAL_TEST_ACCESS_ENABLED=false

# Only test acquiring credentials, never SberBank Online credentials
SBER_SANDBOX_ENABLED=false
SBER_USERNAME=
SBER_PASSWORD=

# Enable only after test acquiring credentials and HTTPS callback setup
SBER_WEBHOOK_ENABLED=false

APP_ENV=local
MAIL_DELIVERY=local
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=promtmarket@mail.ru
SMTP_PASSWORD=
SMTP_FROM=promtmarket@mail.ru
LEGAL_READY=false
