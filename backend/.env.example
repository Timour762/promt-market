APP_NAME=??????????? API
DATABASE_URL=postgresql+asyncpg://promt:local_only@localhost:5438/promt_market

# Generate a random value of at least 32 characters locally. Never commit the real secret.
CSRF_SECRET=replace_with_a_random_local_secret_at_least_32_chars
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:3107","http://127.0.0.1:3107"]

# Generate with Fernet.generate_key(), store only in your private .env.
MAIL_ENCRYPTION_KEY=replace_with_a_generated_fernet_key
PUBLIC_WEB_URL=http://localhost:3107
MAIL_DELIVERY=local

LOCAL_TEST_ACCESS_ENABLED=false

# Only test acquiring credentials, never SberBank Online credentials
SBER_SANDBOX_ENABLED=false
SBER_USERNAME=
SBER_PASSWORD=

# Enable only after test acquiring credentials and HTTPS callback setup
SBER_WEBHOOK_ENABLED=false

APP_ENV=local
MAIL_DELIVERY=local
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=promtmarket@mail.ru
SMTP_PASSWORD=
SMTP_FROM=promtmarket@mail.ru
# Render Free blocks SMTP ports: select MAIL_DELIVERY=brevo after configuring a Brevo account.
# Verify this sender in Brevo; create an API key (not an SMTP key). Never commit the real key.
BREVO_API_KEY=
BREVO_FROM=
BREVO_FROM_NAME=ПромтМаркет
# Alternative HTTPS relay for a Gmail owner; setup: docs/google-mail.md.
# Deploy Apps Script to run as the owner; store the same random secret in its Script Properties.
GOOGLE_MAIL_URL=
GOOGLE_MAIL_SECRET=
LEGAL_READY=false

# Separate Fernet key for merchant card encryption; keep a private backup
# PAYMENT_DETAILS_ENCRYPTION_KEY=generated-fernet-key

# Platega: obtain merchant credentials after your store is approved.
# Set PUBLIC_WEB_URL to the public HTTPS store origin before enabling payments.
# Configure callback URL: https://your-store.example/api/payments/platega/webhook
# USDT wallet, network, conversion and withdrawal terms are configured with Platega.
PLATEGA_ENABLED=false
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
